# NexusStream Environment Configuration Template
# Copy this file to local.properties or your CI environment variables.

# YouTube Data API v3 Key (Optional official API fallback)
# Leave blank to rely entirely on the high-performance InnerTube extractor.
# When provided, ensure this key is restricted in Google Cloud Console:
# 1. Application restrictions: Android apps
#    - Package name: com.nexusstream.app
#    - SHA-1 certificate fingerprint:
#      Obtained from keystore/nexusstream.p12 via:
#      keytool -list -v -keystore keystore/nexusstream.p12 -storepass nexusstream
# 2. API restrictions: YouTube Data API v3
YT_API_KEY=

# Vite Dev Server Port
PORT=3000
